<div class="ln-inventory" data-lunatar-inventory>
  <header class="ln-inventory-top">
    <div class="ln-inventory-title">
      <img src="icons/svg/item-bag.svg" alt="">
      <div><span class="ln-kicker">Pertences e provisões</span><h2>Inventário</h2><small data-inventory-count aria-live="polite"></small></div>
    </div>
    {{#if pc}}
    <div class="ln-wallet" aria-label="Moedas">
      <label><span><i class="fa-solid fa-sun" aria-hidden="true"></i> Solares</span> <input type="number" min="0" name="system.moedas.solares" value="{{system.moedas.solares}}"></label>
      <label><span><i class="fa-solid fa-moon" aria-hidden="true"></i> Lunares</span> <input type="number" min="0" name="system.moedas.lunares" value="{{system.moedas.lunares}}"></label>
      <label><span><i class="fa-solid fa-star" aria-hidden="true"></i> Estelares</span> <input type="number" min="0" name="system.moedas.estelares" value="{{system.moedas.estelares}}"></label>
    </div>
    {{/if}}
  </header>
  <section class="ln-loadout" aria-label="Itens equipados">
    {{#each loadout}}
    <div class="ln-loadout-slot">
      <h3>{{label}}</h3>
      {{#if name}}
      <div class="ln-loadout-item">
        <img src="{{img}}" alt="">
        <button type="button" data-action="edit" data-id="{{id}}">{{name}}</button>
        {{#if ../editable}}<button type="button" data-action="equip" data-id="{{id}}" title="Mover ou guardar {{name}}" aria-label="Mover ou guardar {{name}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button>{{/if}}
      </div>
      {{else}}<span class="ln-loadout-empty">Livre</span>{{/if}}
    </div>
    {{/each}}
  </section>
  <div class="ln-inventory-filters" data-inventory-filters>
    <label>Buscar no inventário
      <input type="search" data-inventory-query placeholder="Nome ou propriedade" autocomplete="off">
    </label>
    <label><input type="checkbox" data-inventory-equipped> Só equipados</label>
  </div>
  {{#each inventory}}
  <section class="ln-inventory-group ln-inventory-{{type}}" data-inventory-group>
    <header class="ln-inventory-group-head">
      <h3><i class="fa-solid {{#if catalog}}{{#if isWeapon}}fa-burst{{else}}fa-shield-halved{{/if}}{{else}}fa-box-open{{/if}}" aria-hidden="true"></i> {{label}} <small>{{items.length}}</small></h3>
      {{#if ../editable}}<div class="ln-buttons">
        {{#if catalog}}<button type="button" data-action="catalog" data-kind="{{type}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Catálogo</button>{{/if}}
        <button type="button" data-action="add" data-kind="{{type}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> Adicionar</button>
      </div>{{/if}}
    </header>
    {{#if items}}<div class="ln-inventory-columns ln-inventory-labels" aria-hidden="true"><span>Item</span><span>Dados</span><span>{{#if ../editable}}Ações{{/if}}</span></div>{{/if}}
    {{#each items}}
    <div class="ln-inventory-columns ln-inventory-row" data-item-id="{{id}}" data-document-class="Item"
      data-search="{{name}} {{system.propriedades}} {{#if weapon}}{{hands}}{{/if}} {{wornAt}}" data-equipped="{{#if wornAt}}true{{else}}false{{/if}}">
      <div class="ln-inventory-item">
        <button type="button" class="ln-inventory-item-name" data-action="edit" data-id="{{id}}" title="Abrir {{name}}">
          <img src="{{img}}" alt="" draggable="false"><strong>{{name}}</strong>
        </button>
        {{#if wornAt}}<span class="ln-equipped"><i class="fa-solid fa-check" aria-hidden="true"></i> {{wornAt}}</span>{{/if}}
      </div>
      <div class="ln-inventory-stats">
        {{#if weapon}}<strong class="ln-inventory-value">{{system.dano}}</strong> <span class="ln-hands-tag">{{hands}}</span>{{#if system.alcance}} <span>{{system.alcance}} m</span>{{/if}}
        {{#if system.propriedades}}<small>{{system.propriedades}}</small>{{/if}}{{/if}}
        {{#if armor}}{{#if system.escudo}}<strong class="ln-inventory-value">Defesa +{{system.defesa}}</strong>{{else}}<strong class="ln-inventory-value">Proteção {{system.protecao}}</strong> <span>Fardos {{system.fardos}}</span>{{/if}}{{/if}}
        {{#if gear}}<strong class="ln-inventory-value">×{{system.quantidade}}</strong> <span>Quantidade</span>{{/if}}
      </div>
      {{#if ../../editable}}
      <div class="ln-inventory-controls">
        {{#unless armor}}<button type="button" data-action="use" data-id="{{id}}" class="ln-inventory-use" title="{{action}} {{name}}">
          <i class="fa-solid {{#if weapon}}fa-burst{{else}}fa-comment{{/if}}" aria-hidden="true"></i> {{action}}
        </button>{{/unless}}
        <button type="button" data-action="equip" data-id="{{id}}" class="ln-inventory-use"
          aria-pressed="{{#if wornAt}}true{{else}}false{{/if}}" title="Mudar posição de {{name}}">
          <i class="fa-solid fa-hand" aria-hidden="true"></i> {{#if wornAt}}Mover ou guardar{{else}}Equipar{{/if}}
        </button>
        <button type="button" data-action="remove" data-id="{{id}}" title="Remover {{name}}" aria-label="Remover {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
      </div>
      {{/if}}
    </div>
    {{/each}}
    <p class="ln-inventory-empty" data-inventory-empty {{#if items}}hidden{{/if}}>{{#if items}}Nenhum item corresponde aos filtros.{{else}}Nenhum item nesta categoria.{{/if}}</p>
  </section>
  {{/each}}
</div>

<div class="ln-spellbook">
  <header class="ln-spellbook-header">
    <div class="ln-spellbook-title">
      <img src="icons/svg/book.svg" alt="">
      <div><h2>Formulações</h2><small>{{system.magia.value}} / {{system.magia.max}} PM</small></div>
    </div>
    {{#if editable}}<div class="ln-buttons">
      {{#if canCompose}}<button type="button" class="ln-primary" data-action="compose"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Compor</button>{{/if}}
      <button type="button" data-action="add" data-kind="formulacao"><i class="fa-solid fa-plus" aria-hidden="true"></i> Criar manualmente</button>
    </div>{{/if}}
  </header>
  <div class="ln-spell-grid">
    {{#each groups.formulacao.items}}
    <article class="ln-spell-card" data-item-id="{{id}}" data-document-class="Item">
      <div class="ln-spell-name">
        <img src="{{img}}" alt="" draggable="false">
        <div><h3>{{name}}</h3>
          {{#if system.forma}}<p>{{system.forma}}{{#if system.palavra}} · {{system.palavra}}{{/if}}{{#if system.palavraExtra}} · {{system.palavraExtra}}{{/if}}</p>{{/if}}
        </div>
      </div>
      <div class="ln-spell-tags">
        <span><i class="fa-solid fa-droplet" aria-hidden="true"></i> {{cost}} PM</span>
        <span>{{system.custoAcao}} ação(ões)</span>
        {{#if system.reflexo}}<span>Reflexo {{system.reflexo}}d4</span>{{/if}}
        {{#if system.controle}}<span>Controle</span>{{/if}}
      </div>
      {{#if system.descricao}}
      <details class="ln-spell-effect"><summary>Ver efeitos</summary><p>{{system.descricao}}</p></details>
      {{/if}}
      <div class="ln-spell-card-actions">
        {{#if ../editable}}<button type="button" class="ln-primary" data-action="use" data-id="{{id}}"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Conjurar</button>{{/if}}
        <button type="button" data-action="edit" data-id="{{id}}" aria-label="Abrir {{name}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{#if ../editable}}Editar{{else}}Abrir{{/if}}</button>
        {{#if ../editable}}<button type="button" class="ln-spell-delete" data-action="remove" data-id="{{id}}" title="Remover {{name}}" aria-label="Remover {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}
      </div>
    </article>
    {{else}}
    <p class="ln-spell-empty">Nenhuma formulação registrada.{{#if editable}} Use os botões acima para começar.{{/if}}</p>
    {{/each}}
  </div>
</div>
